# Set DRY_RUN=true until your Meta WhatsApp Business account is approved
# (or until you've logged in to the web_js provider, see below). In dry-run
# mode, no real messages are sent -- providers log what would have been sent.
DRY_RUN=true

# 'cloud_api' = official Meta Business Platform (requires an approved WABA, see SETUP_META.md).
# 'web_js' = interim unofficial bridge (whatsapp-web.js) for use before that's set up.
# See WEBJS_INTERIM.md before using web_js -- it violates WhatsApp's ToS and risks a ban.
WHATSAPP_PROVIDER=cloud_api

# --- Meta WhatsApp Cloud API credentials (see SETUP_META.md; only used when WHATSAPP_PROVIDER=cloud_api) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- whatsapp-web.js interim bridge (only used when WHATSAPP_PROVIDER=web_js) ---
# Where the linked-device session is saved after "npm run whatsapp:login", so
# you don't have to re-scan the QR code every run.
WHATSAPP_WEBJS_SESSION_PATH=./data/wwebjs_auth

# Webhook verification (you choose this value; enter the same one in the
# Meta App Dashboard webhook subscription screen)
WEBHOOK_VERIFY_TOKEN=change-me

# App Secret from Meta App Dashboard -- used to verify webhook signatures
META_APP_SECRET=

# --- Local server / throttling ---
PORT=3000
DB_PATH=./data/app.db

# Conservative default: WhatsApp new numbers start in a tier limited to
# 250 unique contacts messaged per rolling 24h. Raise this only after Meta
# has upgraded your number's tier.
TIER_LIMIT_PER_24H=250
MESSAGES_PER_SECOND=5
