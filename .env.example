# Set DRY_RUN=true until your Meta WhatsApp Business account is approved.
# In dry-run mode, no real requests are sent to Meta -- the client logs what
# would have been sent instead. See SETUP_META.md for how to get real values.
DRY_RUN=true

# --- Meta WhatsApp Cloud API credentials (see SETUP_META.md) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Webhook verification (you choose this value; enter the same one in the
# Meta App Dashboard webhook subscription screen)
WEBHOOK_VERIFY_TOKEN=change-me

# App Secret from Meta App Dashboard -- used to verify webhook signatures
META_APP_SECRET=

# --- Local server / throttling ---
PORT=3000
DB_PATH=./data/app.db

# Conservative default: WhatsApp new numbers start in a tier limited to
# 250 unique contacts messaged per rolling 24h. Raise this only after Meta
# has upgraded your number's tier.
TIER_LIMIT_PER_24H=250
MESSAGES_PER_SECOND=5
