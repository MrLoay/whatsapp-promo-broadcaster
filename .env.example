# Set DRY_RUN=true to test the whole pipeline without sending real messages
# (logs what would have been sent instead). Set to false once you've logged
# in via "npm run whatsapp:login" or the dashboard's WhatsApp page.
DRY_RUN=true

# Sends via whatsapp-web.js (an unofficial bridge) -- see WEBJS_INTERIM.md
# before going live, it violates WhatsApp's ToS and carries a real ban risk.
# The official Meta Cloud API integration returns once a WABA is approved --
# see SETUP_META.md.
WHATSAPP_WEBJS_SESSION_PATH=./data/wwebjs_auth

# Webhook verification (you choose this value; enter the same one in the
# Meta App Dashboard webhook subscription screen, once that's set up)
WEBHOOK_VERIFY_TOKEN=change-me

# App Secret from Meta App Dashboard -- used to verify webhook signatures
META_APP_SECRET=

# --- Local server / throttling ---
PORT=3000
DB_PATH=./data/app.db

# Conservative default: WhatsApp new numbers start in a tier limited to
# 250 unique contacts messaged per rolling 24h. Raise this only after Meta
# has upgraded your number's tier.
TIER_LIMIT_PER_24H=250
MESSAGES_PER_SECOND=5

# --- Dashboard login ---
SESSION_SECRET=change-me-to-a-long-random-string
# JSON array of {"username":"...","passwordHash":"..."} -- generate hashes with:
#   npm run hash-password -- <plaintext-password>
DASHBOARD_USERS=[]
